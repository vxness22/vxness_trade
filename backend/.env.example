# Vxness backend configuration.
#
# Copy to `.env` and fill in. Only the first four matter for a working server;
# everything below them has a sensible default and can be left out.
#
# NOTE: SMTP is NOT configured here. Email settings live in MongoDB, in the
# EmailSettings collection, written once by `node scripts/setupEmail.js`. A
# lost .env does not lose your email configuration.


# ── Required ────────────────────────────────────────────────────────────────

# No default. mongoose.connect() is called with this verbatim, so the server
# will not start without it.
#   local:      mongodb://127.0.0.1:27017/vxness_local
#   production: mongodb://<user>:<password>@127.0.0.1:27017/<db>?authSource=admin
MONGODB_URI=

# Signs every access token, for the website, the mobile app and the desktop
# terminal alike.
#
# TREAT THIS AS RECOVERED, NEVER REGENERATED. A new value invalidates every
# token already issued: every signed-in user is logged out, and every stored
# refresh token stops working. Only generate a fresh one if the old value is
# truly unrecoverable, or if it leaked.
#
# To generate:  openssl rand -base64 48
#
# There is a fallback of 'your-secret-key' in utils/webAuth.js and
# utils/terminalAuth.js. It is a development convenience and nothing more — a
# server running on it is signing tokens with a value published in this repo,
# so anyone could mint a token for any account. Never let production start
# without this set.
JWT_SECRET=

# The live price feed. Without it infowayService serves the last prices it
# persisted to backend/data/lastPrices.json — quotes appear but never move, and
# the daily change backfill cannot run.
INFOWAY_API_KEY=

PORT=5000


# ── Optional (defaults shown) ───────────────────────────────────────────────

# Used to build links in outgoing email. One caller defaults to
# https://vxness.in, another to http://localhost:5173 — set it so both agree.
FRONTEND_URL=https://vxness.in

# Branding in email templates.
EMAIL_SITE_URL=https://vxness.in
EMAIL_LOGO_URL=https://vxness.in/logo.png

# Where admin sign-in OTPs are sent. The code falls back to a personal Gmail
# address if this is unset — set it to an address you control.
ADMIN_OTP_EMAIL=

# Crypto majors stream from Binance's public bookTicker, separately from the
# primary vendor feed. Set to `off` to disable. Default: on.
BINANCE_FEED=

# Vendor REST host. Default: https://data.infoway.io
INFOWAY_REST_BASE=

# Not read anywhere in this codebase; some libraries change behaviour on it.
NODE_ENV=production
