// Windows resource script — gives terminal.exe its own icon so the desktop
// shortcut, taskbar button and Explorer entry all identify the platform
// instead of falling back to the generic Qt/exe icon.
// IDI_ICON1 (id 1) is the lowest icon id, which is what Explorer picks as the
// executable's display icon.
1 ICON "vxness.ico"

1 VERSIONINFO
// Keep in step with AppVersion in installer.iss and the version in the
// download filename the website links to.
FILEVERSION     1,1,5,0
PRODUCTVERSION  1,1,5,0
FILEOS          0x4L
FILETYPE        0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vxness"
            VALUE "FileDescription",  "Vxness Terminal"
            VALUE "FileVersion",      "1.1.5.0"
            VALUE "InternalName",     "terminal"
            VALUE "OriginalFilename", "terminal.exe"
            VALUE "ProductName",      "Vxness Terminal"
            VALUE "ProductVersion",   "1.1.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
