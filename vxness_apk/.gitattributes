# Normalize line endings: store all text files as LF in the repo and keep LF
# in the working tree (prevents the "LF will be replaced by CRLF" warnings on
# Windows). Git auto-detects text vs binary.
* text=auto eol=lf

# Windows batch scripts must stay CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit binary files — never touch their bytes / line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.mp4  binary
*.mov  binary
*.zip  binary
*.jar  binary
*.keystore binary
*.jks  binary
