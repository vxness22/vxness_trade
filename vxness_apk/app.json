{
  "expo": {
    "name": "Vxness",
    "slug": "vxness",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/vxness-icon.png",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 3000
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "vxness.in": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      },
      "bundleIdentifier": "com.vxness.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/vxness-icon.png",
        "backgroundColor": "#000000"
      },
      "backgroundColor": "#000000",
      "package": "com.vxness.app"
    },
    "web": {
      "favicon": "./assets/brand/vxness-favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/vxness-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/brand/vxness-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Vxness to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2FBF71"
        }
      ],
      "./plugins/withWebChart.js"
    ],
    "extra": {}
  }
}
